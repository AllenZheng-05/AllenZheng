// Cloudflare Workers static-assets deployment for allenzheng.com.
// The site is fully static: `pnpm run build` produces ./dist, which Cloudflare serves as-is.
{
  "name": "allenzheng",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
